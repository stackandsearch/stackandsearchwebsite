# Public, non-secret settings only. Never put API keys or passwords in this file.
# Canonical site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://stackandsearch.com
# Search engines may index the site only when this is "on". Leave it off until launch (Phase 7).
SITE_INDEXING=off

# Lead form (footer card + popup): each lead is POSTed here as JSON.
LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the x-lead-secret header.
LEAD_WEBHOOK_SECRET=
# Set to "log" to print leads in the server log instead (testing only).
LEAD_DELIVERY=

# Google Sheet that receives enquiries (Apps Script web app URL and its token)
LEAD_SHEET_URL=
LEAD_SHEET_TOKEN=
